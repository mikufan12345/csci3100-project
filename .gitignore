# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore all environment files (keep a committed example if one is added later).
.env
.env.*
!.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
/public/packs
/public/packs-test

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

# Test and coverage output
/coverage
/spec/examples.txt
rerun.txt
.byebug_history

# Node (Importmap app; ignore if a JS toolchain is added later)
/node_modules
/yarn-error.log
/yarn-debug.log*

# Windows gem launchers. The scripts without .cmd are the ones to commit.
/bin/*.cmd

# Editor and OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# Local agent notes
.clm/

# Local course PDFs. 3100_proposal.pdf contains student IDs and must stay off GitHub.
/3100_proposal.pdf
/project_csci3100_spec.pdf
