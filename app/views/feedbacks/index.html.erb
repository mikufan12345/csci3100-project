<h1>Feedback</h1>

<% if @studio %>
  <p>Signed in to <%= @studio.name %></p>
  <p>
    Filter:
    <form method="get" action="<%= feedbacks_path %>" style="display: inline;">
      <select name="status">
        <option value="">any status</option>
        <% Feedback::STATUSES.each do |name, _| %>
          <option value="<%= name %>" <%= "selected" if params[:status] == name %>><%= name %></option>
        <% end %>
      </select>
      <select name="severity">
        <option value="">any severity</option>
        <% Feedback::SEVERITIES.each do |name, _| %>
          <option value="<%= name %>" <%= "selected" if params[:severity] == name %>><%= name %></option>
        <% end %>
      </select>
      <%= submit_tag "Filter" %>
    </form>
  </p>

  <% if @feedbacks.any? %>
    <table>
      <tr><th>Comments</th><th>Module</th><th>Game</th><th>Status</th><th>Severity</th><th>Version</th></tr>
      <% @feedbacks.each do |note| %>
        <tr>
          <td><%= link_to note.comments, feedback_path(note) %></td>
          <td><%= note.rule_module.title %></td>
          <td><%= note.playtest_session.rulebook_version.game_project.title %></td>
          <td><%= note.status_name %></td>
          <td><%= note.severity_name %></td>
          <td><%= note.playtest_session.rulebook_version.version_number %> (<%= note.playtest_session.rulebook_version.status == RulebookVersion::STATUS_ARCHIVED ? "archived" : "public" %>)</td>
        </tr>
      <% end %>
    </table>
  <% else %>
    <p>No feedback</p>
  <% end %>
<% else %>
  <p>You are not signed in.</p>
<% end %>