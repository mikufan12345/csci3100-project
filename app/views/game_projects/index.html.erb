<h1>Games</h1>

<% if @studio %>
  <p>Signed in to <%= @studio.name %></p>
  <% if current_user&.role == User::STUDIO_ADMIN %>
    <%= link_to "New game", new_game_project_path %>
    <h2>Studio members</h2>
    <ul>
      <% @studio.users.order(:email).each do |member| %>
        <li>
          <%= member.email %>
          <% if member.id == current_user.id %>
            <span>studio admin</span>
          <% else %>
            <%= form_with url: studio_member_path(member), method: :patch, data: { turbo: false } do %>
              <%= label_tag "role_#{member.id}", "Role" %>
              <%= select_tag "user[role]", options_for_select(
                    [["playtester", "playtester"], ["arbiter", "arbiter"]],
                    member.role == User::ARBITER ? "arbiter" : "playtester"
                  ), id: "role_#{member.id}" %>
              <%= submit_tag "Save role" %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <p>You are not signed in.</p>
  <%= link_to "Sign in", new_user_session_path %>
<% end %>

<table>
  <tr><th>Title</th></tr>
  <% @game_projects.each do |game| %>
    <tr><td><%= link_to game.title, game_project_path(game) %></td></tr>
  <% end %>
</table>
<% if @game_projects.empty? %>
  <p>No games yet.</p>
<% end %>