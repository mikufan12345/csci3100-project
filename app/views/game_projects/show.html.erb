<% content_for :title, @game_project.title %>
<h1><%= @game_project.title %></h1>
<% if current_user&.role == User::STUDIO_ADMIN %>
  <%= form_with model: @game_project do |f| %>
    <p>
      <%= f.label :title %><br />
      <%= f.text_field :title %>
    </p>
    <%= f.submit "Save game" %>
  <% end %>
<% else %>
  <p><%= @game_project.title %></p>
<% end %>